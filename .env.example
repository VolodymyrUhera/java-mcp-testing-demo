# ==========================================
# Environment Configuration for JiraMCP
# ==========================================

# Render Platform Integration API Key (Used by @niyogi/render-mcp)
RENDER_API_KEY=your_render_api_key_here

# Port for DemoWebServer (Default: 8080)
PORT=8080

# Primary Endpoint for Retro90s MCP Server (Default: http://localhost:8081/message)
RETRO90S_MCP_URL=http://localhost:8081/message

# Target Base URL for Testing Scenarios (Default: http://localhost:8080)
BASE_URL=http://localhost:8080
